APP_NAME=SDLC Platform
SUPABASE_URL=https://oecdzywomnbojbmgnclp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ENCRYPTION_KEY=run-python-generate_key.py

# Sessions (optional). Empty SESSION_SECRET derives a key from ENCRYPTION_KEY.
SESSION_SECRET=
SESSION_TTL_HOURS=168
# Set true when served over HTTPS.
SESSION_COOKIE_SECURE=false

# How sign-in codes for existing accounts are delivered: smtp | console | disabled
# console = development only: the code is written to the server log, never to the response.
AUTH_EMAIL_MODE=disabled

# Real delivery through a Gmail sender (set AUTH_EMAIL_MODE=smtp). Keep real values only in the
# untracked .env or the deployment secret store; never commit them.
#   SMTP_USER / SMTP_FROM: the full Gmail sender address
#   SMTP_PASSWORD: a Google App Password (Google Account > Security > 2-Step Verification >
#   App passwords), not the account password
# AUTH_EMAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=<full Gmail sender address>
SMTP_PASSWORD=<Google App Password>
SMTP_FROM=<same Gmail sender address>

# Agent servers
INIT_AGENT_URL=http://127.0.0.1:3000
